# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FLEET_LIVE_URL=https://fleet-ochre-auyuksg.tmp.now/
NODE_ENV=production

# === Auth / sessions ===
NEXTAUTH_SECRET=replace-with-random-32chars-minimum
NEXTAUTH_URL=http://localhost:3000
AUTH_ALLOWLIST_ENABLED=true
AUTH_ALLOWLIST_EMAILS=demo@testdebug.app,admin@testdebug.app
AUTH_ALLOWLIST_DOMAINS=testdebug.app

# === OAuth2 providers (optional — demo works without) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# === Data (optional) ===
DATABASE_URL=

# === Continuity (public only — no secrets) ===
NEXT_PUBLIC_STRAND_LIVE=https://strand-osint-mesh.vercel.app
NEXT_PUBLIC_AUDIT_SCHEMA=gta.grok.apk.deeplink_audit.v1

# === Vercel (auto-injected on deploy) ===
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=
