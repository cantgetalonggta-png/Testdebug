# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production

# OAuth — leave empty for demo mode; set both to enable real provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Auth allowlist
AUTH_ALLOWLIST_ENABLED=true
AUTH_ALLOWLIST_EMAILS=demo@testdebug.app,admin@testdebug.app
AUTH_ALLOWLIST_DOMAINS=testdebug.app

# Optional
NEXTAUTH_SECRET=replace-with-random-32chars
NEXTAUTH_URL=http://localhost:3000
